{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inventory-pier",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inventory-pier",
      "database_id": "local-inventory-pier-only",
      "migrations_dir": "migrations/core"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "AUTH_ORIGIN": "",
    "MAIL_PROVIDER": "",
    "MAIL_FROM": "",
    "MAIL_RELAY_URL": "",
    "MAIL_ACCOUNT_ID": ""
  }
}

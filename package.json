{
  "name": "inventory-pier",
  "version": "0.1.0",
  "private": true,
  "repository": "https://github.com/just-every/run-pier",
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "build": "rer build",
    "dev": "rer dev",
    "preview": "rer preview",
    "typecheck": "tsc --build --incremental",
    "verify": "rer verify",
    "setup": "rer setup",
    "deploy": "rer deploy",
    "test:runtime": "node tests/runtime.mjs",
    "test:email-link": "node tests/email-link.mjs",
    "onboard": "node scripts/install.mjs",
    "build:app": "vite build",
    "verify:app": "pnpm run build && pnpm run typecheck && pnpm run test:api && pnpm run test:site && node tests/email-link.mjs && node tests/portable.mjs",
    "reset": "rer reset",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "test:api": "node --test --test-concurrency=1 tests/api/*.test.mjs",
    "test:portable": "node tests/portable.mjs",
    "source:lock": "node scripts/edition-authoring/cli.mjs lock",
    "source:check": "node scripts/edition-authoring/cli.mjs check",
    "test:site": "node --test tests/site/*.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.33",
    "@tanstack/react-start": "1.168.50",
    "hono": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.63.0",
    "@runeditrun/rer": "0.2.45",
    "@types/node": "22.18.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.1",
    "marked": "18.0.14",
    "miniflare": "5.20260907.0-alpha",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "undici": "7.29.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "license": "MIT"
}

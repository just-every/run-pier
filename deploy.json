{
  "version": 1,
  "project": "inventory/pier",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "originVar": "AUTH_ORIGIN",
  "vars": {
    "AUTH_LOCAL": "false"
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY"
    },
    {
      "binding": "MAIL_PROVIDER",
      "environment": "MAIL_PROVIDER"
    },
    {
      "binding": "MAIL_FROM",
      "environment": "MAIL_FROM"
    },
    {
      "binding": "EDI_BRIDGE_URL",
      "environment": "EDI_BRIDGE_URL",
      "optional": true
    },
    {
      "binding": "EDI_BRIDGE_TOKEN",
      "environment": "EDI_BRIDGE_TOKEN",
      "optional": true
    },
    {
      "binding": "MAIL_ACCOUNT_ID",
      "environment": "MAIL_ACCOUNT_ID",
      "optional": true
    },
    {
      "binding": "MAIL_RELAY_URL",
      "environment": "MAIL_RELAY_URL",
      "optional": true
    }
  ],
  "platforms": [
    "workers",
    "container"
  ],
  "container": {
    "engine": "workerd"
  },
  "crons": [
    "* * * * *"
  ]
}
